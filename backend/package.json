  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
    "start": "node dist/server.js",
    "start:pm2": "pm2-runtime start ecosystem.config.js",
    "build": "tsc",
    "create-indexes": "ts-node src/scripts/createIndexes.ts",
    "check-env": "ts-node --transpile-only src/scripts/checkEnv.ci.ts",
    "lint": "eslint src && node ../scripts/check-no-console.mjs",
    "backup:db": "ts-node --transpile-only src/scripts/backupDb.ts",
    "backup:media": "ts-node --transpile-only src/scripts/backupMedia.ts",
    "test": "cross-env NODE_ENV=test npm run build && cross-env NODE_ENV=test ts-node --transpile-only src/scripts/smokeTest.ts && cross-env NODE_ENV=test jest --coverage --runInBand --forceExit",
    "test:integration": "cross-env NODE_ENV=test jest --coverage --runInBand --forceExit",
    "backup:products": "node recovery/scripts/daily_product_backup.js",
    "export:products": "node recovery/scripts/daily_product_backup.js"
  },
