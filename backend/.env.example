# ═══════════════════════════════════════════════════════
# Siri Arts & Crafts — Environment Configuration Template
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control!

# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/siri-arts
# MONGO_POOL_SIZE=20  # Optional: MongoDB connection pool size (default: 20)

# Auth & Security
JWT_SECRET=replace_with_at_least_32_character_secret_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
OTP_EXPIRY_MINUTES=5
# BYPASS_OTP_CODE=123456  # Optional: A secure master code to bypass OTP checks (useful if SMTP is blocked in production)

# Admin Credentials
# In production, ADMIN_PASSWORD should be a bcrypt hash.
# Generate one with: node -e "require('bcryptjs').hash('your_password', 10).then(console.log)"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_admin_password

# CORS (comma-separated production origins)
FRONTEND_URLS=http://localhost:5173,http://localhost:3000

# SMTP (Transactional Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (Payment Gateway — required in production)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Optional: Monitoring & AI
SENTRY_DSN=
GROQ_API_KEY=
