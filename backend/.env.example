# WARNING: SECURITY RISK - Real credentials must NEVER be committed to version control.
# If this file has ever been exposed, rotate all passwords and API keys immediately!
# ─── Siri Arts & Crafts — Environment Configuration ───

# ═══════════════════════════════════════════════════════
# 1. SERVER & SYSTEM BASE
# ═══════════════════════════════════════════════════════
PORT=YOUR_VALUE_HERE
NODE_ENV=YOUR_VALUE_HERE
# Base Frontend URL (Used for generating internal links/emails)
FRONTEND_URL=YOUR_VALUE_HERE
# Comma-separated list of allowed frontend origins for CORS
FRONTEND_URLS=YOUR_VALUE_HERE
# Shared domain for cross-site cookies if applicable (e.g. .siriartsandcrafts.com) or leave empty if separate domains
COOKIE_DOMAIN=
AI_SERVICE_URL=YOUR_VALUE_HERE

# ═══════════════════════════════════════════════════════
# 2. DATABASE CONNECTIONS
# ═══════════════════════════════════════════════════════
MONGO_URI=YOUR_VALUE_HERE
ALLOW_PROD_DB_LOCAL=YOUR_VALUE_HERE

# ═══════════════════════════════════════════════════════
# 3. SECURITY & TOKEN SIGNING
# ═══════════════════════════════════════════════════════
JWT_SECRET=YOUR_VALUE_HERE
JWT_EXPIRES_IN=YOUR_VALUE_HERE
REFRESH_TOKEN_EXPIRES_DAYS=YOUR_VALUE_HERE
OTP_EXPIRY_MINUTES=YOUR_VALUE_HERE

# ═══════════════════════════════════════════════════════
# 4. MASTER ADMIN PRIVILEGES
# ═══════════════════════════════════════════════════════
ADMIN_EMAIL=YOUR_VALUE_HERE
SUPER_ADMIN_EMAIL=YOUR_VALUE_HERE
ADMIN_PASSWORD=YOUR_VALUE_HERE
ADMIN_PHONE=YOUR_VALUE_HERE

# ═══════════════════════════════════════════════════════
# 5. PAYMENT INTEGRATIONS (RAZORPAY)
# ═══════════════════════════════════════════════════════
RAZORPAY_KEY_ID=YOUR_VALUE_HERE
RAZORPAY_KEY_SECRET=YOUR_VALUE_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_VALUE_HERE

# ═══════════════════════════════════════════════════════
# 6. CLOUDINARY MEDIA STORE
# ═══════════════════════════════════════════════════════
CLOUDINARY_CLOUD_NAME=YOUR_VALUE_HERE
CLOUDINARY_API_KEY=YOUR_VALUE_HERE
CLOUDINARY_API_SECRET=YOUR_VALUE_HERE

# ═══════════════════════════════════════════════════════
# 7. TRANSACTIONAL EMAIL SYSTEM (SMTP)
# ═══════════════════════════════════════════════════════
SMTP_HOST=YOUR_VALUE_HERE
SMTP_PORT=YOUR_VALUE_HERE
SMTP_USER=YOUR_VALUE_HERE
SMTP_PASS=YOUR_VALUE_HERE

# ═══════════════════════════════════════════════════════
# 8. Auto Fill Details
# ═══════════════════════════════════════════════════════
GROQ_API_KEY=YOUR_VALUE_HERE

# ═══════════════════════════════════════════════════════
# 9. REDIS CONFIGURATION (PRODUCTION INTEGRATION)
# ═══════════════════════════════════════════════════════
REDIS_URL=
REQUIRE_REDIS=YOUR_VALUE_HERE
# Trust Proxy: 0 = Local/Direct, 1 = Render/Heroku (1 proxy), 2 = Cloudflare + Render (2 proxies)
TRUST_PROXY_HOPS=YOUR_VALUE_HERE

# 10. FIELD-LEVEL ENCRYPTION (MUST differ from JWT_SECRET)
FIELD_ENCRYPTION_KEY=YOUR_VALUE_HERE
ENABLE_WORKERS=YOUR_VALUE_HERE
ENABLE_CRON=YOUR_VALUE_HERE

# 11. SECRET ROTATION TRACKING
SECRET_ROTATION_REMINDER=YOUR_VALUE_HERE
SMTP_FROM_EMAIL=YOUR_VALUE_HERE
BACKEND_URL=YOUR_VALUE_HERE
BYPASS_OTP_CODE=YOUR_VALUE_HERE

# ═══════════════════════════════════════════════════════
# 12. BACKUP & DISASTER RECOVERY
# ═══════════════════════════════════════════════════════
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_V1=
BACKUP_SIGNING_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_REGIONS=ap-south-1
BACKUP_RETENTION_DAILY_DAYS=30
BACKUP_RETENTION_WEEKLY_WEEKS=12
BACKUP_RETENTION_MONTHLY_MONTHS=12
BACKUP_RETENTION_YEARLY_YEARS=7
BACKUP_IMMUTABLE_DEFAULT_MONTHLY=true
BACKUP_IMMUTABLE_DEFAULT_YEARLY=true
BACKUP_ROLLBACK_SNAPSHOT_RETENTION_DAYS=7
GITHUB_BACKUP_OWNER=
GITHUB_BACKUP_REPO=
GITHUB_BACKUP_TOKEN=
ALERT_WEBHOOK_URL=
BACKUP_ANOMALY_THRESHOLD_SIZE_STDDEV=2
BACKUP_ANOMALY_THRESHOLD_DURATION_MULTIPLIER=3
BACKUP_ANOMALY_THRESHOLD_COUNT_DROP_PERCENT=10
BACKUP_CHAOS_SCHEDULE=weekly
