# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/eventdecor

# Auth
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_DAYS=30
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_in_production

# Email — Brevo HTTP API (recommended; works on Render free tier, port 443)
BREVO_API_KEY=
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME=Siri Arts & Crafts

# Email — SMTP fallback (local dev; blocked on some cloud free tiers)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URLs
FRONTEND_URLS=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Reverse-proxy hop count for rate-limit IP accuracy (Render=1, Cloudflare+Render=2)
TRUST_PROXY_HOPS=1

# Real-time (required for multi-instance Socket.io)
REDIS_URL=
# Set to true in production when running 2+ instances without REDIS_URL to fail fast
REQUIRE_REDIS=false

# Observability
SENTRY_DSN=
LOG_LEVEL=warn

# Frontend CDN assets (optional)
# VITE_MARBLE_TEXTURE_URL=https://res.cloudinary.com/.../marble.webp

# OTP (development only — never set in production)
# BYPASS_OTP_CODE=
