# ##############################################################################
# SECURITY WARNING: Never commit real credentials to version control!
# This is a template file for environment variables. Use placeholder values.
# Copy this file to `.env` and fill in your real credentials there.
# ##############################################################################

# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/eventdecor
# Connection pool per API instance (default 20 local; use 10 on Render when running 2+ instances)
# Atlas connection limit ≈ pool × instance count — monitor in Atlas → Metrics
MONGO_POOL_SIZE=10

# Auth
# 🚨 NEVER COMMIT REAL VALUES TO VERSION CONTROL
# JWT_SECRET must be at least 32 cryptographically random characters
# Recommended rotation: every 90 days. Run `openssl rand -hex 32` to generate.
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
# AES-256 field encryption for twoFactorSecret — REQUIRED in production (must differ from JWT_SECRET)
# Recommended rotation: every 90 days. Run `openssl rand -hex 32` to generate.
FIELD_ENCRYPTION_KEY=change_me_to_a_random_32char_string
# Short-lived access tokens (matches production Render — refresh flow is exercised locally)
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
# Automatically triggers a fatal startup error if the current date passes this value
# Format: YYYY-MM-DD
SECRET_ROTATION_REMINDER=
ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_EMAIL=
ADMIN_PASSWORD=change_me_in_production

# Email — Brevo HTTP API (recommended; works on Render free tier, port 443)
BREVO_API_KEY=
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME=Siri Arts & Crafts

# Email — SMTP fallback (local dev; blocked on some cloud free tiers)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# 🚨 MUST be a strong, cryptographically random string in production (e.g. openssl rand -hex 32)
# The security of the payment verification flow depends entirely on this secret.
RAZORPAY_WEBHOOK_SECRET=

# Media (Required for images, CDN, and Health API)
# Get these from your Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URLs
FRONTEND_URLS=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Reverse-proxy hop count — MUST match your deployment proxy chain for accurate client IPs
# (rate limits, audit logs, Socket.io connection limits). See docs/DEPLOYMENT.md.
#   Render only:              TRUST_PROXY_HOPS=1
#   Cloudflare → Render:      TRUST_PROXY_HOPS=2
#   Local dev (no proxy):     TRUST_PROXY_HOPS=0
TRUST_PROXY_HOPS=1

# Real-time & Caching (Required for Socket.io and API performance caching)
# Upstash / Redis Cloud: use rediss:// URL (TLS enabled automatically)
REDIS_URL=
# Fail startup if REDIS_URL is missing (set true in production / Render)
REQUIRE_REDIS=true
# Session cache TTLs are fixed in code (profile 60s, cart 30s, wishlist 60s)
# Skip automatic index build on startup (local dev only)
# SKIP_INDEX_BUILD=true

# Admin dashboard Redis cache TTL in seconds (default 300 = 5 min for heavy aggregates)
# Admin dashboard Redis cache TTL in seconds (default 300 = 5 min for heavy aggregates)
ADMIN_ANALYTICS_CACHE_TTL=300

# AI Features (Product descriptions, CMS content generation)
GROQ_API_KEY=

# Observability
SENTRY_DSN=
LOG_LEVEL=warn
# Set true only when debugging traffic (very noisy in production)
# LOG_API_SUCCESS=true
# Slow request warning threshold (ms) when LOG_API_SUCCESS is false
# SLOW_REQUEST_LOG_MS=3000

# CDN delivery probe (cron + /api/health?full=1). Lite /api/health uses cache only.
# CDN_PROBE_DISABLED=true
# CDN_HEALTH_CACHE_TTL_MS=300000
# CDN_FAIL_CACHE_TTL_MS=60000
# CDN_PROBE_TIMEOUT_MS=8000

# Frontend CDN assets (optional)
# VITE_MARBLE_TEXTURE_URL=https://res.cloudinary.com/.../marble.webp

# CI/integration: apply production-like rate limits (3 req/min per IP on /api/)
# TEST_RATE_LIMIT=true

# OTP (development only — never set in production)
# BYPASS_OTP_CODE=

# Seed script — required; aborts if any non-Cloudinary image URL is present
SEED_IMAGES_SOURCE=cloudinary
