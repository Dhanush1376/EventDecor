{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://siri-arts-n-crafts.onrender.com/sitemap.xml"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    }
  ]
}
