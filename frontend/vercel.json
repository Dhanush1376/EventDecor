{
  "trailingSlash": false,
  "functions": {
    "api/page-meta.js": {
      "maxDuration": 10
    },
    "api/sitemap.js": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/shop",
      "destination": "/collections",
      "statusCode": 301
    },
    {
      "source": "/showcases",
      "destination": "/events",
      "statusCode": 301
    },
    {
      "source": "/gallery",
      "destination": "/collections",
      "statusCode": 301
    },
    {
      "source": "/gallery/:path*",
      "destination": "/collections",
      "statusCode": 301
    },
    {
      "source": "/custom-orders",
      "destination": "/collections",
      "statusCode": 301
    },
    {
      "source": "/customize/:path*",
      "destination": "/collections",
      "statusCode": 301
    },
    {
      "source": "/my-custom-orders",
      "destination": "/dashboard/orders",
      "statusCode": 301
    },
    {
      "source": "/shipping",
      "destination": "/policy/shipping-policy",
      "statusCode": 301
    },
    {
      "source": "/returns",
      "destination": "/policy/return-policy",
      "statusCode": 301
    },
    {
      "source": "/exchange",
      "destination": "/policy/exchange-policy",
      "statusCode": 301
    },
    {
      "source": "/refund",
      "destination": "/policy/refund-policy",
      "statusCode": 301
    },
    {
      "source": "/cancellation",
      "destination": "/policy/terms-and-conditions",
      "statusCode": 301
    },
    {
      "source": "/privacy",
      "destination": "/policy/privacy-policy",
      "statusCode": 301
    },
    {
      "source": "/terms",
      "destination": "/policy/terms-and-conditions",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/product/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|slurp|facebookexternalhit|facebookcatalog|whatsapp|telegram|discord|pinterest|linkedin|skypeuripreview|embedly|vkshare|redditbot|applebot|yandex|baidu|duckduck).*"
        }
      ],
      "destination": "/api/page-meta?type=product&id=:id"
    },
    {
      "source": "/events/:id((?!book$|dashboard$|collections$)[^/]+)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|slurp|facebookexternalhit|facebookcatalog|whatsapp|telegram|discord|pinterest|linkedin|skypeuripreview|embedly|vkshare|redditbot|applebot|yandex|baidu|duckduck).*"
        }
      ],
      "destination": "/api/page-meta?type=event&id=:id"
    },
    {
      "source": "/api/:path*",
      "destination": "https://eventdecor-fg3l.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://eventdecor-fg3l.onrender.com/socket.io/:path*"
    },
    {
      "source": "/collections",
      "destination": "/_seo/shop.html"
    },
    {
      "source": "/events",
      "destination": "/_seo/events.html"
    },
    {
      "source": "/about",
      "destination": "/_seo/about.html"
    },
    {
      "source": "/contact",
      "destination": "/_seo/contact.html"
    },
    {
      "source": "/blog",
      "destination": "/_seo/blog.html"
    },
    {
      "source": "/policy/privacy-policy",
      "destination": "/_seo/policy-privacy-policy.html"
    },
    {
      "source": "/policy/terms-and-conditions",
      "destination": "/_seo/policy-terms-and-conditions.html"
    },
    {
      "source": "/policy/shipping-policy",
      "destination": "/_seo/policy-shipping-policy.html"
    },
    {
      "source": "/policy/return-policy",
      "destination": "/_seo/policy-return-policy.html"
    },
    {
      "source": "/policy/exchange-policy",
      "destination": "/_seo/policy-exchange-policy.html"
    },
    {
      "source": "/policy/refund-policy",
      "destination": "/_seo/policy-refund-policy.html"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/app-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com https://cdn.razorpay.com https://unpkg.com https://static.cloudflareinsights.com https://cdn.logr-in.com https://*.logrocket.io https://accounts.google.com/gsi/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://res.cloudinary.com https://flagcdn.com https://images.unsplash.com https://lh3.googleusercontent.com https://eventdecor-fg3l.onrender.com https://*.pinimg.com https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://*.basemaps.cartocdn.com https://basemaps.cartocdn.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.cloudinary.com https://eventdecor-fg3l.onrender.com wss://eventdecor-fg3l.onrender.com https://api.razorpay.com https://*.sentry.io https://*.logrocket.io https://*.cloudflareinsights.com https://accounts.google.com; worker-src 'self' blob:; frame-src 'self' https://checkout.razorpay.com https://api.razorpay.com https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests;"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!api/|socket.io/|assets/|.*\\.).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|svg|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/dashboard",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/dashboard/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/cart",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/checkout",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/wishlist",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/order-success",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/track/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/accept-invite",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/coupons",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/invoice-preview",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/booking-success/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/events/book",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/events/dashboard",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/product/:id/reviews",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/product/:id/reviews/images",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}
